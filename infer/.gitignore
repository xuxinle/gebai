# 引擎二进制：官方预编译包或自建产物，体积大且可重新获取/自建
vendor/

# 引擎源码与下载缓存：从上游获取（codeload / releases），不入库——只保留 README 与 patches/
engine/llama.cpp-*/
engine/dl/

# 基准与启动记录：可复现生成（infer_bench / run-server 每次运行重写）
bench/reports/*.json
bench/reports/*.md
bench/reports/*.log
bench/reports/*.log.err
# 批量推理任务产物（输入副本 / 结果 JSONL / 任务状态）
bench/runs/
# 运行态状态文件（服务实例 PID/端口/日志，可重建）
run/
# 剖析报告（nsys 产物，可用 scripts 重新采集）
bench/nsys/

# Python 缓存
__pycache__/
*.pyc
