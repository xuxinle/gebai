{
  "name": "gebai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/server dev",
    "dev:desktop": "bun run --cwd packages/desktop dev",
    "dev:web": "bun run --cwd packages/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && bun run scripts/typecheck-custom.ts && bun run typecheck:scripts",
    "typecheck:custom": "bun run scripts/typecheck-custom.ts",
    "typecheck:scripts": "bunx tsc -p scripts/tsconfig.json",
    "e2e:term": "bun run scripts/e2e/files-e2e.mjs",
    "e2e:term:tui": "bun run scripts/e2e/files-tui.mjs",
    "e2e:term:edit": "bun run scripts/e2e/files-edit.mjs",
    "e2e:term:all": "bun run scripts/e2e/files-e2e.mjs && bun run scripts/e2e/files-tui.mjs && bun run scripts/e2e/files-edit.mjs",
    "lint": "turbo run lint",
    "build:code": "bun run scripts/build-code-agent.ts",
    "resources:download": "bun run scripts/download-resources.ts",
    "resources:check": "bun run scripts/download-resources.ts --check",
    "infer:list": "pwsh -NoProfile -File infer/scripts/restore.ps1 -List",
    "infer:check": "pwsh -NoProfile -File infer/scripts/restore.ps1 -Check",
    "infer:restore": "pwsh -NoProfile -File infer/scripts/restore.ps1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "turbo": "^2.5.0"
  },
  "packageManager": "bun@1.2.0"
}
