# secrets & local env — never commit
.env
.env.*
!.env.example

# 演进调度状态（生生 shengsheng 子Agent 托管：.evolve/control.md 与 ledger.md）——
# 项目本地的驻留开发台账，非项目产物；多台机器/多开发者各自一份，不入库
.evolve/
# 仓级共享租约（.evolve-shared/leases.json）：落在 **git 顶层**，是同一棵树上多条演进线共用的
# 独占资源登记（跨线的“谁在用这台机器”）。它是**运行时状态**而不是项目文件，同 .evolve/ 一样不入库。
# 注意：它可能落在仓库根也可能落在任一子目录（取决于哪条线先领），故用无路径前缀的裸模式。
.evolve-shared/

# 逆向验证 / 门禁的三类**运行时状态文件**（都是设计上该留在盘上的诊断线索，不是项目文件）——
# 用无路径前缀的裸模式：它们落在 packages/agents/src/agents/shengsheng/ 下，也可能落在
# 任意被验的源码目录里。
# ① 逆向验证的临时回退备份（正常退出会删；SIGKILL/异常会留）——首行残留即「上一轮未完成」的线索
*.revbak
# ② 回退演练的救援快照（`reverse_verify.py` 的演练钩子明写「非 *.revbak，脚本不会碰」——用于 SIGKILL 场景救援）
*.drill-snapshot
# ③ verify_guard 的并发锁（陈旧时按 pid 存活 + boot_id 自清，但自清只在下次拿锁时触发，所以会长期留在盘上）
.reverse_verify.lock

# 相期（Xiāngqī）的运行期数据目录：inbox/outbox/seen.txt 是卡片投递与答复的**本地状态**，
# 不是项目文件。缺省落在 {GEBAI_HOME}/xiangqi，未设时回退 <cwd>/xiangqi（测试、临时实例、
# 直接跑二进制都会在 cwd 下长出来）——故用无路径前缀的裸模式。
xiangqi/
# 旧版目录名（中文）：仍保留忽略，避免用旧构建产物在仓库里种出这个目录时误入库。
相期/

# deps
node_modules/

# 离线供给预置（docker/browsers|bun|node）：浏览器目录与运行时二进制，均为几百 MB 的本地预置，
# 由 docker/build.sh --export-browsers / --export-runtimes 在联网侧生成后拷到内网使用——不进版本库。
docker/browsers/
docker/bun/
docker/node/

# build output
dist/
build/
out/
# 桌面端编译产物（bun --compile --outfile=gebai）
packages/desktop/gebai

# turbo
.turbo/

# coverage
coverage/

# logs
*.log
gebai.log

# 运行时数据（GEBAI_HOME when script-debug at repo root）
users/
tmp/
audit-fs.jsonl
feishu/
# 拟人模式运行时数据（{GEBAI_HOME}/persona/：feishu-user-token.json 是**用户令牌凭据**、
# drivers.json、memory.md、outbox/）。以 GEBAI_HOME=仓库根 运行时落在根下——
# 里面是明文 access/refresh token，与 .env 同级敏感，绝不能入库。
/persona/
# 运行期缓存（{GEBAI_HOME}/cache/：子Agent 报告解析缓存等，以 GEBAI_HOME=仓库根 运行时在根下生成）
/cache/
# 二进制形态运行时物化点（{GEBAI_HOME}/vendor/：playwright driver 与 pwcore、d2js、ripgrep、
# 客卿预置物化；以 GEBAI_HOME=仓库根 运行编译产物时在根下生成，dev 形态不经此路径。
# 本地 CV 运行时不在此——它在 resources/vendor/cv，随资源目录整体忽略）
/vendor/
# 调度主实例锁（{GEBAI_HOME}/.gebai-primary.json，运行时文件）
.gebai-primary.json
.gebai-primary.json.*.tmp
# Python 语言目录 venv 与依赖清单（keqing/python/，{agent}_pip 自动创建/维护）
keqing/python/venv/
keqing/python/requirements.txt
__pycache__/
# 客卿运行时数据（索引/缓存等，GEBAI_HOME 下）
keqing-data/
# 客卿编译产物与构建目录（keqing/{cpp,rust,go}/ 下）：
# 驱动可执行体形态：Windows driver.exe / Linux·macOS 无后缀 driver；
# 其余为编译器中间产物（MSVC driver.obj/pdb/ilk/exp/lib、go build 覆盖写入的 driver.exe~）。
# 逐后缀枚举而非 driver* 通配——后者会误伤源码同名文件（如 python/driver.py）。
# target/ 为 cargo 构建目录。
keqing/**/driver
keqing/**/driver.exe
keqing/**/driver.exe~
keqing/**/driver.obj
keqing/**/driver.pdb
keqing/**/driver.ilk
keqing/**/driver.exp
keqing/**/driver.lib
keqing/rust/target/
# 客卿 Rust workspace 的锁文件（子代理 sidecar）。**只限该 workspace**：
# packages/desktop/launcher/Cargo.lock 是桌面启动器的依赖锁（随二进制构建入库），不属本规则。
keqing/rust/Cargo.lock

# OS
.DS_Store
Thumbs.db

# editor
.idea/
.reasonix/

# 设计预览稿（不提交、不进构建产物）
docs/preview-screens/
packages/web/public/preview-*
packages/web/public/mobile-mock.html

*.exe
# 构建时生成的子 Agent bundle 注册表（由 scripts/build-subagents.ts 生成）
packages/server/src/core/subagents.bundle.generated.ts
# 构建时生成的全局工具 bundle 注册表（由 scripts/build-tools.ts 生成）
packages/server/src/core/tools/bundle.generated.ts
# 构建时生成的 Web UI bundle 注册表（由 scripts/build-web-bundle.ts 生成）
packages/server/src/core/web.bundle.generated.ts
# 构建时生成的 D2.js 内嵌产物注册表（由 scripts/build-d2js.ts 生成）
packages/server/src/core/d2js.embedded.generated.json
packages/server/src/core/analyzer-wasm.embedded.generated.json
# 构建时生成的 playwright driver 内嵌产物（由 scripts/build-driver-embed.ts 生成）
packages/server/src/core/driver.embedded.generated.json
# 构建时生成的 playwright-core 内嵌产物（由 scripts/build-pwcore-embed.ts 生成）
packages/server/src/core/pwcore.embedded.generated.json
# 构建时生成的本地 CV（ort + PP-OCR 模型）内嵌产物（由 scripts/build-cv-embed.ts 生成）
packages/server/src/core/cv.embedded.generated.json
# 构建时生成的内置 ripgrep 内嵌产物（由 scripts/build-rg-embed.ts 生成）
packages/server/src/core/rg.embedded.generated.json
# 构建时从 node_modules 拷贝的 @plantuml/core 引擎（由 scripts/copy-plantuml.ts 生成）
packages/web/public/vendor/
# 构建时从 favicon.svg 生成的大脑图标 ICO（由 scripts/gen-icon.ts 生成）
packages/desktop/icons/

# 原生 WebView 启动器 Rust 构建产物（cargo target）
packages/desktop/launcher/target/

# bun build 编译临时文件
*.bun-build

# bun lockfile（不提交，bun install 时本地生成）
bun.lock
packages/server/src/core/cv/cvdriver.embedded.generated.json

# 构建产物一律不入库（历史遗留的同名文件也一并移出跟踪）：包路径迁移后旧规则只覆盖
# packages/server/...，agents 包新路径 packages/agents/src/core/*.embedded.generated.json
# 曾被连带入库——此兜底规则匹配任意路径，防止再次误提交（构建时由对应 scripts/build-*-embed.ts 生成）
*.embedded.generated.json
# 反例（勿再加进来）：packages/server/src/core/session/env-embedded.generated.ts **必须入库**——
# 空态默认值源码（与 tools-excluded.generated.ts 同策略），被 compose.ts 静态导入：
# 不入库会让新克隆环境 `bun run dev` 直接 Cannot find module（历史踩坑：仓库瘦身时误随
# 二进制内嵌产物一并移出跟踪）。内置构建后为含密钥脏态属预期，构建脚本编译后立即还原空态。

# 资源子仓库（模型/运行时依赖，独立 git 仓库管理——见 resources/README.md）
/resources/
# 旧资源目录名（历史布局，仅作解析回退）
/models/
# 本地推理实例的独立数据根（infer/scripts/run-gebai-local.ps1 创建：会话与用户数据隔离，
# resources/ 以目录联接指向仓库资源）
/.gebai-local/
# Go 工具链分发包（本地下载缓存，勿提交）
go.zip

# ── 生成成品与二进制资产不入库 ──
# 媒体素材（截图 / 底图 / 生成图 / 视频 / 音频）由 imagegen、裁云、镂月等能力在本地生成——
# 它们体积大、可复现、且会随每次调参反复变化，入库只会让历史膨胀、diff 噪音化。
# 需要随仓库分发的**功能必需**图标（PWA manifest、示例应用图标）用下文 `!` 规则显式放行。
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.ico
# 例外：Windows 可执行文件的**图标资源是构建输入**，不是生成物。
# 没有它，`st build <target>` 会直接报“声明的图标不存在”——
# 而生成脚本（tools/make_ico.py）需要先有一张源 PNG，不能凭空重建。
# 其余 `*.ico`（截图/导出产物）仍然不入库。
!**/assets/**/*.ico
*.mp4
*.mov
*.webm
*.avi
*.wav
*.mp3
*.m4a
*.flac

# 生成媒体目录里的成品：用「排除全部 + 显式放行必需项」而不是排除整个目录——
# 目录级排除会让下面的 ! 放行全部失效（git 无法对“父目录已排除”的内容重新包含），实测踩到。
shuangtian/examples/*/assets/media/*.png
# 示例资产里的**生成物**：仓库只沉淀能力，不沉淀产物。
#
# 判据不是大小而是来源：手写的小示例（图层数个位数~几十）入库；
# 由脚本批量生成的大 JSON（上千图层、上万顶点坐标）不入库——
# 它们随时可重造，入库只会让 diff/克隆变重。
# 实测：4 个这样的文件合计 1.2 MB，夹在能力提交里很难被注意到。
#
# 用「按文件名忽略」而不是排除目录：目录级排除会让其它 ! 放行失效（同上面的坑）。
shuangtian/examples/caiyun/assets/loss-descent.json
shuangtian/examples/caiyun/assets/scale-carry.json
shuangtian/examples/caiyun/assets/cam-compare-*.json
shuangtian/examples/*/assets/vo/*.wav

# 放行：应用与示例运行所必需的图标（删了 manifest 或示例脚本会失效）
!packages/web/public/icons/icon-192.png
!packages/web/public/icons/icon-512.png
!packages/web/public/icons/*.png
!shuangtian/examples/gbcode/assets/gbcode-icon.png
!shuangtian/examples/louyue/assets/sample.png

# 放行：入门示例（sample-basic / sample-cinematic）引用的底图——
# 这几个是“克隆后第一眼看到的东西”，缺图会让示例看起来像坏的。
# 它们命名固定、体量小（每个 <1MB）、且不随调参变化（区别于 gb-*/cyber-* 这类生成物）。
!shuangtian/examples/caiyun/assets/media/bg-aurora.png
!shuangtian/examples/caiyun/assets/media/bg-deep.png
!shuangtian/examples/caiyun/assets/media/bg-mesh.png
!shuangtian/examples/caiyun/assets/media/bg-slate.png
!shuangtian/examples/caiyun/assets/media/accent-glow.png

# 文档截图（README/DESIGN 内联引用的界面图，属于文档本体）
!docs/screenshots/*.png

# 裁云工程包的**迁移产物**：由 tools/caiyun_migrate_styles_to_packages.py 生成，
# 可用一条命令重建，且包里含 intent.md 骨架与 scene.json（与源脚本同内容的不同形态）。
# 源脚本 film.json / film-multishot.json 才是真值源，包不入库。
*.cypkg/
commit-msg.txt
