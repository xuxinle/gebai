# secrets & local env — never commit
.env
.env.*
!.env.example

# deps
node_modules/

# build output
dist/
build/
out/
# 桌面端编译产物（bun --compile --outfile=gebai）
packages/desktop/gebai

# turbo
.turbo/

# coverage
coverage/

# logs
*.log
gebai.log

# 运行时数据（GEBAI_HOME when script-debug at repo root）
users/
tmp/
feishu/
# Python 语言目录 venv 与依赖清单（keqing/python/，docqa_pip 自动创建/维护）
keqing/python/venv/
keqing/python/requirements.txt
__pycache__/
# 客卿运行时数据（docqa 索引等，GEBAI_HOME 下）
keqing-data/
# 客卿编译产物与构建目录（keqing/{cpp,rust,go}/ 下）：
# 驱动可执行体形态：Windows driver.exe / Linux·macOS 无后缀 driver；
# 其余为编译器中间产物（MSVC driver.obj/pdb/ilk/exp/lib、go build 覆盖写入的 driver.exe~）。
# 逐后缀枚举而非 driver* 通配——后者会误伤源码同名文件（如 python/driver.py）。
# target/ 为 cargo 构建目录。
keqing/**/driver
keqing/**/driver.exe
keqing/**/driver.exe~
keqing/**/driver.obj
keqing/**/driver.pdb
keqing/**/driver.ilk
keqing/**/driver.exp
keqing/**/driver.lib
keqing/rust/target/
Cargo.lock

# OS
.DS_Store
Thumbs.db

# editor
.idea/
.reasonix/

# 设计预览稿（不提交、不进构建产物）
docs/preview-screens/
packages/web/public/preview-*
packages/web/public/mobile-mock.html

*.exe
# 构建时生成的子 Agent bundle 注册表（由 scripts/build-subagents.ts 生成）
packages/server/src/core/subagents.bundle.generated.ts
# 构建时生成的全局工具 bundle 注册表（由 scripts/build-tools.ts 生成）
packages/server/src/core/tools/bundle.generated.ts
# 构建时生成的 Web UI bundle 注册表（由 scripts/build-web-bundle.ts 生成）
packages/server/src/core/web.bundle.generated.ts
# 构建时生成的 D2.js 内嵌产物注册表（由 scripts/build-d2js.ts 生成）
packages/server/src/core/d2js.embedded.generated.json
packages/server/src/core/analyzer-wasm.embedded.generated.json
# 构建时生成的 playwright driver 内嵌产物（由 scripts/build-driver-embed.ts 生成）
packages/server/src/core/driver.embedded.generated.json
# 构建时生成的 playwright-core 内嵌产物（由 scripts/build-pwcore-embed.ts 生成）
packages/server/src/core/pwcore.embedded.generated.json
# 构建时生成的本地 CV（ort + PP-OCR 模型）内嵌产物（由 scripts/build-cv-embed.ts 生成）
packages/server/src/core/cv.embedded.generated.json
# 本地 CV 模型下载目录（scripts/build-cv-embed.ts 下载，体积大不入库）
packages/server/assets/cv-models/
# 构建时从 node_modules 拷贝的 @plantuml/core 引擎（由 scripts/copy-plantuml.ts 生成）
packages/web/public/vendor/
# 构建时从 favicon.svg 生成的大脑图标 ICO（由 scripts/gen-icon.ts 生成）
packages/desktop/icons/

# 原生 WebView 启动器 Rust 构建产物（cargo target）
packages/desktop/launcher/target/

# bun build 编译临时文件
*.bun-build

# bun lockfile（不提交，bun install 时本地生成）
bun.lock
packages/server/src/core/cv/cvdriver.embedded.generated.json

# 资源子仓库（模型/原生依赖，独立 git 仓库管理——见 models/README.md）
/models/
# Go 工具链分发包（本地下载缓存，勿提交）
go.zip  
