{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "../../keqing/**", "../../custom/**", "../../packages/*/src/**"]
    },
    "@gebai/desktop#build": {
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "scripts/**",
        "launcher/**",
        "package.json",
        "../../keqing/**",
        "../../custom/**",
        "../../packages/*/src/**",
        "../../packages/*/package.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "../../keqing/**", "../../custom/**", "../../packages/*/src/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
