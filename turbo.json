{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@gebai/desktop#build": {
      "outputs": ["dist/**"],
      "inputs": ["src/**", "scripts/**", "launcher/**", "package.json", "../../packages/server/src/**", "../../packages/server/scripts/**", "../../packages/web/src/**", "../../packages/web/package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
