{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "歌白",
  "version": "0.1.0",
  "identifier": "com.gebai.desktop",
  "build": {
    "beforeDevCommand": "bun run --cwd ../web build",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "bun run --cwd ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "歌白",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/gebai"],
    "resources": ["../dist/driver.mjs"]
  }
}
