{
  "name": "@gebai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/build-vendor.ts && vite",
    "build": "bun run scripts/build-vendor.ts && bun run scripts/clean-dist.ts && vite build",
    "build:watch": "bun run scripts/build-vendor.ts && bun run scripts/clean-dist.ts && vite build --watch",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@gebai/sdk": "workspace:*",
    "@plantuml/core": "^1.2026.6",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "markdown-it": "^15.0.0",
    "modern-screenshot": "^4.7.0"
  },
  "devDependencies": {
    "@terrastruct/d2": "^0.1.33",
    "@types/bun": "latest",
    "@types/markdown-it": "^14.1.2",
    "mermaid": "^11.16.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
