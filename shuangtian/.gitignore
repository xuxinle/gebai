# 构建产物（自研工具链 `st` 的输出：对象/库/可执行/预编译头/依赖清单）
build/

# 崩溃转储与临时文件
#
# **不要用裸 `core`**：gitignore 的模式匹配路径的**任意一段**，所以 `core` 会连
# `include/st/core/`、`src/core/` 一起忽略——框架核心模块曾因此整个没入过库
# （克隆下来根本编不过）。转储统一是 `core` 或 `core.<pid>`，用下面两条精确匹配。
/core
core.[0-9]*
*.o
*.d
*.gch

# 编辑器/系统
.DS_Store
*.swp

# 运行时副产物（控制文件/截图/基准产物：应用在工程目录跑起来时落盘）
.st/
*.link
*.log.err

# 构建/测试日志（`st build|test|lint` 每次自动落盘，见 `tools/stpm/cli_log.hpp`）
# 它们每次运行都会生成，属于**事后查证材料**而不是源码：不入库，但也不要删
# （用户可能还要回溯）。目录固定 `.st/logs/`，已被上一条 `.st/` 覆盖；
# 这里显式重复一次是为了让“为什么这些文件不入库”在 gitignore 里可读。
.st/logs/

# 手工/脚本产生的临时测量输出（重定向到文件是测量纪律，见 docs/BUILD_TEST_PERF.md §0）
tmp/logs/

# 演进台账（auto_evolve 会话内部工作文件，不进仓库/交付）
.evolve/

# 裁云工程的配音轨：TTS/录音生成的外部产物（二进制、可重新生成），只留脚本引用
examples/caiyun/assets/vo/*.wav
examples/caiyun/_build/
examples/caiyun/kit/_build/

# 裁云示例工程的渲染产物（可随时重建，不入库）
#
# 风格模板示例（examples/caiyun/styles/<编号>-<名字>/）**只入库脚本**：
# film.json / layout.js / 各驱动脚本。`_build/` 里是 kit 拼接产物与 resolved json，
# 都是跑一次就有的中间物，入库只会互相覆盖。
#
# 成片与抽帧**一律落会话目录**（不落代码目录）：代码目录的产物会被入仓检查弄丢，
# 且多个片子并行时同名文件互相覆盖——历史消息里按路径引用的产物会变成别的内容。
examples/caiyun/styles/*/_build/
examples/caiyun/styles/**/*.mp4
examples/caiyun/styles/**/*.wav
examples/caiyun/styles/**/frames/

# 示例应用自己落盘的本地数据（示例内置库的可重建产物，不是源码）
examples/cefu/cefu.db

examples/caiyun/mtfilm/qa/*.mp4
examples/caiyun/mtfilm/qa/*.png
examples/caiyun/mtfilm/qa/*.log
