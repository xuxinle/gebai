# 构建产物（自研工具链 `st` 的输出：对象/库/可执行/预编译头/依赖清单）
build/

# 崩溃转储与临时文件
#
# **不要用裸 `core`**：gitignore 的模式匹配路径的**任意一段**，所以 `core` 会连
# `include/st/core/`、`src/core/` 一起忽略——框架核心模块曾因此整个没入过库
# （克隆下来根本编不过）。转储统一是 `core` 或 `core.<pid>`，用下面两条精确匹配。
/core
core.[0-9]*
*.o
*.d
*.gch

# 编辑器/系统
.DS_Store
*.swp

# 运行时副产物（控制文件/截图/基准产物：应用在工程目录跑起来时落盘）
.st/
*.link
*.log.err

# 演进台账（auto_evolve 会话内部工作文件，不进仓库/交付）
.evolve/

# 裁云工程的配音轨：TTS/录音生成的外部产物（二进制、可重新生成），只留脚本引用
examples/caiyun/assets/vo/*.wav
examples/caiyun/_build/
examples/caiyun/kit/_build/

# 示例应用自己落盘的本地数据（示例内置库的可重建产物，不是源码）
examples/cefu/cefu.db
