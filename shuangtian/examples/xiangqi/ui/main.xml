<?xml version="1.0" encoding="UTF-8"?>
<!--
  相期 · 界面结构（零 C++ UI 代码）

  ## 这个应用是什么

  agent 在你桌面上的**一个常驻窗口**。它做三件事：
  ① 提示你（有事要说，等你读）
  ② 请你选择（几个选项，等你定夺）
  ③ 待办等待（这件事卡住了，等你动一下）

  名字取「相期」——两端相对而等：agent 那头等你确认，你这头等它交活。
  界面按这个关系组织：上半是「它跟你说的」，下半是「它等你做的」。

  ## 为什么是 xmlapp 形态

  与 xmlapp 同一开发方式：本文件只管「长什么样」，`app.js` 管「怎么动」，
  C++ 侧只装配并暴露能力（agent 投递来的卡片从哪来、答复往哪去）。
  这样**改提醒/选择的呈现方式不必动 C++**——那正是这类界面最常改的部分。

  ## 结构

  ┌─ 标题栏：相期 + 徽标（待你处理数）
  ├─ 卡片区（grow）：一张卡片 = 一件事
  │    提示卡 · 选择卡 · 待办卡
  └─ 底部：连接状态 + 忽略全部

  根元素必须 grow="true"：它挂在 WindowFrame::content() 下，
  不 grow 只占内容高 → 底部那条会跑到窗口中间（xmlapp 踩过）。
-->
<Column id="root" gap="0" grow="true" surface="base">

  <!-- ✗ 不再有 XML 层标题栏：`WindowFrame` 已经带了一条（图标 + 标题 + 窗口控制按钮）。
       两边各写一份的结果是**图标与「相期」重复两遍**，且一个跟窗口走、一个不跟。
       徽标（待你处理数）与连接状态改为挂进真标题栏的 trailing 槽（见 main.cpp），
       这样它们与标题同一行、不会被内容区遮住。 -->

  <!-- 卡片区：一件事一张卡，按到达顺序排列。
       注：卡片区包在 `<Scroll>` 里——之前是裸 Column，卡片超过 3 张时
       后面的会被底部栏压住（演示截图里第四张就是这样没的）。列表本来就会长。

       `ScrollView::add_child` 会把内容子元素插到滚动条**之前**（条恒在末尾），
       所以这里直接写 XML 子节点就是对的（不需要 content 属性那种写法）。 -->
  <Scroll id="cards-scroll" grow="true">
    <Column id="cards" gap="10" padding="14"/>
  </Scroll>

  <!-- 轻提示形态（compact）：只显示最新一条，输入区与底部都隐藏。
       为何要这个形态：notice 类不该把整个主界面拉出来——
       人只是被通知一声，给他一整个工作面板是打扰。
       窗口本身会同步缩到小尺寸贴角（挨 application.set_window_size）。 -->
  <Column id="compact" gap="10" padding="14" grow="true" visible="false">
    <Row id="compact-head" gap="8">
      <Icon id="compact-icon" icon="bell" size="16" text_color="#d97706"/>
      <Text id="compact-kind" size="12" text_color="#d97706">有事告诉你</Text>
      <Spacer grow="true"/>
      <Text id="compact-more" size="11" text_color="#9ca3af"/>
    </Row>
    <Text id="compact-title" size="15"></Text>
    <!-- 正文用 markdown：大模型给的内容天然是 markdown，
         当纯文本画会把 `**粗**`、`- 项`、代码块原样露出来。 -->
    <MarkdownView id="compact-body" max_height="120"></MarkdownView>
    <Row id="compact-act" gap="8" padding_y="4">
      <Button id="compact-expand" label="展开" variant="ghost" size="small"
              hint="打开完整面板（处理选择与待办）"/>
      <Button id="compact-ok" label="知道了" variant="soft" size="small"/>
      <Spacer grow="true"/>
      <!-- 连接状态：轻提示形态下**也必须有**。
           为何不能省：这一形态把主界面底部栏整体隐了，若这里再不显示，
           断线时整个窗口里没有任何“已断开”的痕迹——用户以为 agent 还在盯着，
           而提醒根本没送到。那是比“不弹窗”更糟的状态。 -->
      <Icon id="compact-link-icon" icon="warning" size="12" text_color="#dc2626"/>
      <Text id="compact-link" size="11" visible="false">已连接</Text>
    </Row>
  </Column>

  <!-- 空状态：没有卡片时显示（与徽标呼应，避免空白窗口让人以为挂了）
       注：纵向容器的主轴是竖向，所以「内容居中」用 justify；
       align 是**交叉轴**（这里为横向）——两者不可混。 -->
  <Column id="empty" gap="6" padding="40" grow="true" justify="center">
    <Icon id="empty-icon" icon="sun" size="32" text_color="#9ca3af"/>
    <Text id="empty-title" size="15" text_color="#6b7280">这里空着</Text>
    <Text id="empty-hint" size="12" text_color="#9ca3af">agent 有事找你时会放到这里</Text>
  </Column>

  <!-- ✗ 不再有底部栏：连接状态与「全部忽略」都上提到真标题栏了（见 main.cpp）。
       理由同上——它们都是“说明状态/轻操作”，没必要占一整条栏。 -->
</Column>
