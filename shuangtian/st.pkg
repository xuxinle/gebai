      "exclude_sources": ["src/pkg/*"]
    },
    "gpu_probe": {
      "kind": "executable",
      "sources": ["tools/gpu_probe.cpp"],
      "//": "软件画布 vs GPU 画布的导出实测（1080p / 无头 / 裁云负载）"
    },
    "gpu_vs_cpu_export_probe": {
      "kind": "executable",
      "sources": ["tools/gpu_vs_cpu_export_probe.cpp"],
      "//": "构建增量判定加内容哈希的成本（对比 stat / fnv / sha256）"
    },
    "deps_hash_cost_probe": {
      "kind": "executable",
      "sources": ["tools/deps_hash_cost_probe.cpp"],
      "//": "deferred context 可行性（并行录制 vs 串行回放）"
    },
    "deferred_ctx_probe": {
      "kind": "executable",
      "sources": ["tools/deferred_ctx_probe.cpp"],
      "//": "GPU 导出的时间去向（回读 / 转换 / 拷贝各占多少）"
    },
    "gpu_export_cost_probe": {
      "kind": "executable",
      "sources": ["tools/gpu_export_cost_probe.cpp"],
      "//": "frame_stats 降采样是否真的看到帧间差异（验证 still_ratio 恒 100% 的根因）",
      "include_dirs": ["examples/caiyun"]
    },
    "frame_stats_diff_probe": {
      "kind": "executable",
      "sources": ["tools/frame_stats_diff_probe.cpp", "examples/caiyun/frame_stats.cpp"],
      "//": "vignette 四条渐变带的代价（横向 vs 竖向 vs 纯色）"
    },
    "vignette_cost_probe": {
      "kind": "executable",
      "sources": ["tools/vignette_cost_probe.cpp"],
      "//": "grain（4200 个 1px 小圆）的代价与替代实现对照"
    },
    "grain_cost_probe": {
      "kind": "executable",
      "sources": ["tools/grain_cost_probe.cpp"],
      "//": "layout 图元要多大 alpha/尺寸才能让 32x18 网格逐帧差达标"
    },
    "layout_alpha_probe": {
      "kind": "executable",
      "sources": ["tools/layout_alpha_probe.cpp"],
      "include_dirs": ["examples/caiyun"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "本机 GPU 腿可用性（无头模式下 st doctor 有意不探测 GPU，这里显式探一次）"
    },
    "motion_qa": {
      "kind": "executable",
      "sources": ["tools/motion_qa.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "动效验收（通用）：画面沿用率 + 变化强度 + 元素身份；支持 --ref 同口径对照"
    },
    "caiyun_js_probe": {
      "kind": "executable",
      "sources": ["tools/caiyun_js_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "link": ["st_ext"],
      "//note": "JS 编排能否替代 JSON 描述：C++ 函数可调 / 一遍 eval 产出图层表 / 配额 / 报错定位"
    },
    "scene3d_texture_probe": {
      "kind": "executable",
      "sources": ["tools/scene3d_texture_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "三维纹理与 UV 是否真的贴上且位置正确（v 轴翻转、双线性采样）"
    },
    "scene3d_color_probe": {
      "kind": "executable",
      "sources": ["tools/scene3d_color_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "颜色管线接入后的视觉对照：同一场景新旧两条输出链各落一张 PNG + 亮度/过曝统计"
    },
    "scene3d_script_probe": {
      "kind": "executable",
      "sources": ["tools/scene3d_script_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "用一份 JSON 描述整个三维场景：解析/报错指路/渲染/参数生效/确定性"
    },
    "scene3d_blender_probe": {
      "kind": "executable",
      "sources": ["tools/scene3d_blender_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "2026-10-24 新增能力探针：材质基色/自发光/点光/聚光/AgX/正交，逐项证明真的生效"
    },
    "scene3d_capability_matrix": {
      "kind": "executable",
      "sources": ["tools/scene3d_capability_matrix.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "三维能力矩阵：逐项核对软件腿/GPU腿是否都真的支持（阴影/透明/金属高光）"
    },
    "scene3d_shadow_probe": {      "kind": "executable",
      "sources": ["tools/scene3d_shadow_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "平面投影阴影：强度四档各落一张 PNG + 地面/球体/阴影区亮度对比"
    },
    "scene3d_lights_probe": {      "kind": "executable",
      "sources": ["tools/scene3d_lights_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "多光源对照：主光/补光/轮廓光/暖色补光各落一张 PNG + 亮面与暗面亮度"
    },
    "scene3d_shade_equiv_probe": {      "kind": "executable",
      "sources": ["tools/scene3d_shade_equiv_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "渐进采用底线：默认材质（specular/emission/metallic = 0）必须与旧 shade_terms 逐位等价"
    },
    "scene3d_material_probe": {
      "kind": "executable",
      "sources": ["tools/scene3d_material_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "Principled 材质对照：五种参数（塑料/金属/自发光）各落一张 PNG + 均值/峰值/高光占比"
    },
    "scene3d_cull_probe": {
      "kind": "executable",
      "sources": ["tools/scene3d_cull_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "背面剔除的**方向**（单面平面 + 两个相机位置；封闭体分辨不出方向对错）"
    },
    "scene3d_composite_probe": {
      "kind": "executable",
      "sources": ["tools/scene3d_composite_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "三维零拷贝合成 vs 回读：有显卡就用显卡的成败点（回读会把显卡的收益全吃掉）"
    },
    "scene3d_two_legs_probe": {
      "kind": "executable",
      "sources": ["tools/scene3d_two_legs_probe.cpp"],
      "exclude_sources": ["src/pkg/*"],
      "//note": "三维两条腿（GPU/软件）对照：光栅成本与回读成本分开量，决定“有显卡就用显卡”值不值"
    },
    "scene3d_cost_probe": {
      "kind": "executable",
      "sources": ["tools/scene3d_cost_probe.cpp"],
