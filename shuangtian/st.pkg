{
  "name": "shuangtian",
  "version": "0.1.0",
  "kind": "static_library",
  "cxx_standard": 20,
  "include_dirs": ["include", "third_party"],
  "modules": ["core", "math", "codec", "raster", "text", "md", "ui", "shell", "gpu", "control", "app", "pkg"],
  "sources": [
    "src/core/*.cpp",
    "src/math/*.cpp",
    "src/codec/*.cpp",
    "src/raster/*.cpp",
    "src/text/*.cpp",
    "src/md/*.cpp",
    "src/ui/*.cpp",
    "src/ui/components/*.cpp",
    "src/shell/*.cpp",
    "src/gpu/*.cpp",
    "src/control/*.cpp",
    "src/app/*.cpp",
    "src/pkg/*.cpp",
    "src/ext/*.cpp"
  ],
  "embed": ["src/ui/script_api.js"],
  "third_party_sources": ["third_party/quickjs/*.c"],
  "c_flags": ["-std=gnu11"],
  "tests": ["tests/*_test.cpp"],
  "flags": [
    "-fno-strict-aliasing",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-Wconversion",
    "-Wshadow",
    "-Wpedantic",
    "-Wold-style-cast",
    "-Wnon-virtual-dtor",
    "-Wcast-align",
    "-Wnull-dereference",
    "-Woverloaded-virtual",
    "-Wdouble-promotion",
    "-Wimplicit-fallthrough"
  ],
  "defines": ["ST_VERSION=\"0.1.0\"", "ST_ENABLE_LINT=1"],
  "system_libs": ["pthread", "dl", "m"],
  "toolchains": {
    "mingw": {
      "compiler": "x86_64-w64-mingw32-g++",
      "c_compiler": "x86_64-w64-mingw32-gcc",
      "platform": "windows",
      "system_libs": ["ws2_32", "winpthread", "gdi32", "user32"],
      "defines": ["_WIN32_WINNT=0x0A00", "WINVER=0x0A00", "NTDDI_VERSION=0x0A000000"],
      "executable_suffix": ".exe",
      "extra_flags": ["-static-libgcc", "-static-libstdc++"]
    }
  },
  "targets": {
    "st": { "kind": "executable", "sources": ["tools/stpm/*.cpp"], "system_libs": ["dl"] },
    "gallery": { "kind": "executable", "sources": ["examples/gallery/*.cpp"],
                 "exclude_sources": ["src/pkg/*"],
                 "embed": ["examples/gallery/assets/*"] },
    "mdeditor": { "kind": "executable", "sources": ["examples/mdeditor/*.cpp"], "exclude_sources": ["src/pkg/*"] },
    "codeeditor": { "kind": "executable", "sources": ["examples/codeeditor/*.cpp"],
                  "exclude_sources": ["src/pkg/*"],
                  "embed": ["examples/codeeditor/assets/*"] }
  },
  "dependencies": {
    "modules": [],
    "source": [],
    "system": ["pthread", "dl", "m"]
  }
}
