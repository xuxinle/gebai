    },
    "sprite_color_key_probe": {
      "kind": "executable",
      "sources": ["tools/sprite_color_key_probe.cpp"],
      "exclude_sources": ["src/pkg/*"]
    },
    "round_rect_route_probe": {
      "kind": "executable",
      "sources": ["tools/round_rect_route_probe.cpp"],
