{
  "name": "shuangtian",
  "version": "0.1.0",
  "kind": "static_library",
  "cxx_standard": 20,
  "include_dirs": ["include", "third_party", "third_party/sqlite"],
  "modules": ["core", "math", "codec", "raster", "text", "md", "ui", "shell", "control", "app", "pkg", "ext"],
  "sources": [
    "src/core/*.cpp",
    "src/math/*.cpp",
    "src/codec/*.cpp",
    "src/raster/*.cpp",
    "src/text/*.cpp",
    "src/md/*.cpp",
    "src/ui/*.cpp",
    "src/ui/components/*.cpp",
    "src/shell/*.cpp",
    "src/control/*.cpp",
    "src/app/*.cpp",
    "src/pkg/*.cpp",
    "src/ext/*.cpp"
  ],
  "embed": ["src/ui/script_api.js", "src/ui/declarative.js"],
  "third_party_sources": ["third_party/quickjs/*.c", "third_party/sqlite/*.c"],
  "c_flags": ["-std=gnu11", "-include", "st_sqlite3_config.h"],
  "tests": ["tests/*_test.cpp"],
  "flags": [
    "-fno-strict-aliasing",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-Wconversion",
    "-Wshadow",
    "-Wpedantic",
    "-Wold-style-cast",
    "-Wnon-virtual-dtor",
    "-Wcast-align",
    "-Wnull-dereference",
    "-Woverloaded-virtual",
    "-Wdouble-promotion",
    "-Wimplicit-fallthrough"
  ],
  "defines": ["ST_VERSION=\"0.1.0\"", "ST_ENABLE_LINT=1"],
  "lint": {
    "//": "规则豁免：规则 id → 路径 glob。成片/基于位置的边界走这里（单点破例走行内 // lint-allow）。两通道都需在 CONVENTIONS.md §8 登记，且各自计数、不静默。",
    "exempt": {
      "L14": ["src/core/entry.cpp"]
    }
  },
  "system_libs": ["pthread", "dl", "m"],
  "toolchains": {
    "mingw": {
      "compiler": "x86_64-w64-mingw32-g++",
      "c_compiler": "x86_64-w64-mingw32-gcc",
      "platform": "windows",
      "system_libs": ["ws2_32", "winpthread", "gdi32", "user32"],
      "defines": ["_WIN32_WINNT=0x0A00", "WINVER=0x0A00", "NTDDI_VERSION=0x0A000000"],
      "executable_suffix": ".exe",
      "extra_flags": ["-static-libgcc", "-static-libstdc++"]
    }
  },
  "targets": {
    "st": { "kind": "executable", "sources": ["tools/stpm/*.cpp"], "system_libs": ["dl"] },
    "gallery": { "kind": "executable", "sources": ["examples/gallery/*.cpp"],
                 "exclude_sources": ["src/pkg/*"],
                 "embed": ["examples/gallery/assets/*"] },
    "codeeditor": { "kind": "executable", "sources": ["examples/codeeditor/*.cpp"],
                  "exclude_sources": ["src/pkg/*"],
                  "embed": ["examples/codeeditor/assets/*"] },
    "caret_ink_probe": { "kind": "executable", "sources": ["tools/caret_ink_probe.cpp"],
                         "exclude_sources": ["src/pkg/*"] },
    "font_stack_probe": { "kind": "executable", "sources": ["tools/font_stack_probe.cpp"],
                          "exclude_sources": ["src/pkg/*"] },
    "ring_path_probe": { "kind": "executable", "sources": ["tools/ring_path_probe.cpp"],
                         "exclude_sources": ["src/pkg/*"] },
    "ring_raster_probe": { "kind": "executable", "sources": ["tools/ring_raster_probe.cpp"],
                           "exclude_sources": ["src/pkg/*"] },
    "ink_spread_probe": { "kind": "executable", "sources": ["tools/ink_spread_probe.cpp"],
                          "exclude_sources": ["src/pkg/*"] },
    "weight_spread_probe": { "kind": "executable", "sources": ["tools/weight_spread_probe.cpp"],
                             "exclude_sources": ["src/pkg/*"] },
    "gpu_structural_probe": { "kind": "executable", "sources": ["tools/gpu_structural_probe.cpp"],
                              "exclude_sources": ["src/pkg/*"] },
    "button_center_probe": { "kind": "executable", "sources": ["tools/button_center_probe.cpp"],
                             "exclude_sources": ["src/pkg/*"] },
    "icon_sheet_probe": { "kind": "executable", "sources": ["tools/icon_sheet_probe.cpp"],
                          "exclude_sources": ["src/pkg/*"] }
  },
  "dependencies": {
    "modules": [],
    "source": [],
    "system": ["pthread", "dl", "m"]
  }
}
