    },
    "round_rect_diff_locate_probe": {
      "kind": "executable",
      "sources": ["tools/round_rect_diff_locate_probe.cpp"],
      "exclude_sources": ["src/pkg/*"]
    },
    "shadow_mask_distribution_probe": {
      "kind": "executable",
      "sources": ["tools/shadow_mask_distribution_probe.cpp"],
      "exclude_sources": ["src/pkg/*"]
    },
    "shadow_run_length_probe": {
      "kind": "executable",
      "sources": ["tools/shadow_run_length_probe.cpp"],
      "exclude_sources": ["src/pkg/*"]
    },
    "shadow_cost_breakdown_probe": {
      "kind": "executable",
