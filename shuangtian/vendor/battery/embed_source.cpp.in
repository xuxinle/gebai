//   上游把该模板内嵌在 `CMakeLists.txt` 的 `set(... [==[ ... ]==])` 变量里，
//   由 CMake 在 configure 阶段用 `configure_file` 填充；本仓库改用**自研构建器 stpm**
//   做同一件事（直接驱动编译器、不引入 CMake）。因此这里把模板抽成独立文件，
//   占位符与语义**与上游逐字一致**，以便升级时可直接比对上游 CMakeLists.txt。
//   占位符由 `st build` 填充（见 `src/pkg/embed.cpp`）。
// ============================================================================


// File generated using battery::embed (https://github.com/batterycenter/embed)
// Embedded file: '${FILENAME}' as '${IDENTIFIER}'
// Filesize: ${FILESIZE} bytes
// DO NOT EDIT THIS FILE!!!

#include "battery/embed.hpp"

namespace b {

    EmbedInternal::EmbeddedFile EmbedInternal::${IDENTIFIER} = {
        std::string_view(
            ${GENERATED_BYTE_ARRAY},
            ${FILESIZE}
        )
        , "${FILENAME}"
#ifndef B_PRODUCTION_MODE
        , "${FULL_PATH}"
#endif // !B_PRODUCTION_MODE
    };

} // namespace b
